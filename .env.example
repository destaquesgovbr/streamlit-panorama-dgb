# ============================================================
# Panorama Gov.BR — Variáveis de Ambiente
# ============================================================
# Copie para .env e preencha os valores:
#   cp .env.example .env
#
# Para rodar localmente:
#   source .venv/bin/activate
#   set -a && source .env && set +a
#   streamlit run app/main.py

# ------------------------------------------------------------
# BigQuery (obrigatório)
# ------------------------------------------------------------
# Opção 1: ADC via gcloud (recomendado para dev local)
#   gcloud auth application-default login
#
# Opção 2: Service Account Key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ------------------------------------------------------------
# PostgreSQL (para páginas: Entidades, Mapa Semântico)
# ------------------------------------------------------------
# Conexão direta ao Cloud SQL via Cloud SQL Proxy:
#   cloud-sql-proxy inspire-7-finep:us-east1:govbrnews-postgres --port=5433
# DATABASE_URL=postgresql://destaquesgovbr:SENHA@localhost:5433/govbrnews
#
# Ou via docker-compose local (data-platform/docker-compose.yml):
# DATABASE_URL=postgresql://destaquesgovbr_dev:dev_password@localhost:5433/destaquesgovbr_dev

# ------------------------------------------------------------
# Umami Analytics (para página: Engajamento)
# Disponível quando o Umami estiver configurado no portal.
# A página mostra aviso amigável quando não configurado.
# ------------------------------------------------------------
# UMAMI_API_URL=https://analytics.destaquesgovbr.com.br
# UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# UMAMI_API_TOKEN=seu-token-aqui
